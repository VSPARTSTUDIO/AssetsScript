        return
    lang = get_guild_lang(ctx.guild.id)
    
    if not ctx.message.attachments or not start_str:
        msg = "Please type structural command layout: >cutback <starting duration offset e.g. 0.20> accompanied by audio track" if lang == "en" else "กรุณาพิมพ์โครงสร้างคำสั่งแบบนี้: >cutback <เวลาเริ่มต้นที่จะตัดออก เช่น 0.20> พร้อมแนบไฟล์เสียง"
        return await ctx.send(msg)

    try:
        if "." in start_str:
            parts = start_str.split(".")
            minutes = int(parts[0])
            seconds = float(parts[1])
            start_ms = int((minutes * 60 + seconds) * 1000)
        else:
            start_ms = int(float(start_str) * 1000)
    except:
        msg = "Time variables formatting invalid, specify models parameters like 0.20 (20 secs) or traditional float bounds variables" if lang == "en" else "รูปแบบเวลาไม่ถูกต้อง กรุณาใช้รูปแบบเช่น 0.20 (20 วินาที) หรือจำนวนวินาทีปกติ"
