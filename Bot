@bot.command(name="cut")
async def cut_audio(ctx, duration_str: str = None):
    if ctx.channel.id not in ALLOWED_CHANNEL_IDS:
        return
    lang = get_guild_lang(ctx.guild.id)
    
    if not ctx.message.attachments or not duration_str:
        msg = "Please type structural command formatting: >cut <trim boundary e.g. 1.50> accompanied by audio track" if lang == "en" else "กรุณาพิมพ์โครงสร้างคำสั่งแบบนี้: >cut <เวลาที่จะเหลือไว้ เช่น 1.50> พร้อมแนบไฟล์เสียง"
        return await ctx.send(msg)

    try:
        if "." in duration_str:
            parts = duration_str.split(".")
            minutes = int(parts[0])
            seconds = float(parts[1])
            cutoff_ms = int((minutes * 60 + seconds) * 1000)
        else:
            cutoff_ms = int(float(duration_str) * 1000)
    except:
        msg = "Time formatting invalid parameters, use layouts like 1.50 (1 min 50 secs) or standard integer seconds variables" if lang == "en" else "รูปแบบเวลาไม่ถูกต้อง กรุณาใช้รูปแบบเช่น 1.50 (1 นาที 50 วินาที) หรือจำนวนวินาทีปกติ"
        return await ctx.send(msg)

    desc_msg = f"Slicing audio track segment structure down to first initial {duration_str} section limit..." if lang == "en" else f"กำลังประมวลผลตัดไฟล์เสียงให้เหลือเฉพาะ {duration_str} แรก..."
    msg = await ctx.send(embed=discord.Embed(description=desc_msg, color=THEME_COLOR))

    attachment = ctx.message.attachments[0]
    file_ext = attachment.filename.split('.')[-1].lower()
    temp_in = f"cut_{ctx.author.id}.{file_ext}"
    temp_out = f"cut_out_{ctx.author.id}.ogg"

    try:
        await attachment.save(temp_in)
        loop = asyncio.get_event_loop()

        def process_cut():
            sound = AudioSegment.from_file(temp_in)
            cut_sound = sound[:cutoff_ms]
            cut_sound.export(temp_out, format="ogg")

        await loop.run_in_executor(None, process_cut)

