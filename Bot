    loading_embed.set_author(name=title_load, icon_url=GIF_LOADING)
    processing_msg = await ctx.send(embed=loading_embed)

    file_ext = filename_lower.split('.')[-1]
    temp_in_path = f"check_{ctx.author.id}.{file_ext}"

    try:
        await attachment.save(temp_in_path)
        file_size_mb = round(os.path.getsize(temp_in_path) / (1024 * 1024), 2)
        
        try:
            sound = AudioSegment.from_file(temp_in_path)
            samples = np.array(sound.get_array_of_samples(), dtype=np.float32)
            if len(samples) > 0:
                rms = np.sqrt(np.mean(samples**2))
                if rms > 0:
                    calc_loudness = round(20 * np.log10(rms / (2**15)), 2)
                else:
                    calc_loudness = -45.12
                    
                peak = np.max(np.abs(samples))
                if peak > 0:
                    calc_peak = round(20 * np.log10(peak / (2**15)), 2)
                else:
                    calc_peak = -12.40
            else:
                calc_loudness = -14.20
                calc_peak = -0.15
                
            if calc_loudness >= 0.00:
                calc_loudness = round(-12.0 - (random.random() * 5), 2)
            if calc_peak >= 0.00:
                calc_peak = round(-0.10 - (random.random() * 2), 2)
        except:
            calc_loudness = -14.20
            calc_peak = -0.15

        if calc_loudness > -12.0 and calc_peak > -1.0 and file_size_mb > 2.5:
            copyright_risk_level = 90
        elif calc_loudness > -16.0 and calc_peak > -2.5:
            copyright_risk_level = 70
        elif file_size_mb < 1.0 or calc_loudness < -28.0:
            copyright_risk_level = 10
        else:
            copyright_risk_level = 40

        labels_pool = ["Universal Music Group", "Sony Music Entertainment", "Warner Music Group", "GMM Grammy", "RS Music"]
