@bot.tree.command(name="checkbots", description="ตรวจสอบบอทในยศ BOT👑 ว่าอยู่ที่ไหนบ้าง")
async def checkbots(interaction: discord.Interaction):
    if interaction.channel_id != AUDIT_CHANNEL_ID:
        return await interaction.response.send_message(f"กรุณาใช้ห้อง <#{AUDIT_CHANNEL_ID}>", ephemeral=True)
    
    await interaction.response.defer()
    role = discord.utils.get(interaction.guild.roles, name="BOT👑")
    if not role: 
        return await interaction.followup.send("ไม่พบยศ BOT👑")
    
    bot_members = [m for m in role.members if m.bot]
    if not bot_members: 
        return await interaction.followup.send("ไม่พบสมาชิกที่เป็นบอทในยศนี้")

    for member in bot_members:
        shared_guilds = [g for g in bot.guilds if g.get_member(member.id)]
        embed = discord.Embed(title=f"Audit: {member.name}", color=THEME_COLOR)
        embed.set_thumbnail(url=member.display_avatar.url)
        
        if shared_guilds:
            guild_list = "".join([f"🏠 **{g.name}** (ID: `{g.id}`)\n" for g in shared_guilds])
            embed.add_field(name="Servers detected", value=guild_list)
        else:
            embed.add_field(name="Servers detected", value="ไม่พบข้อมูลในฐานระบบ")
        
        await interaction.followup.send(embed=embed)


