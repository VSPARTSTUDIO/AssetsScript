# --- [ PAGINATOR VIEW FOR SOUNDNAME SEARCH ] ---
class SoundNamePaginator(discord.ui.View):
    def __init__(self, author, query, files_list, lang="th"):
        super().__init__(timeout=60)
        self.author = author
        self.query = query
        self.files_list = files_list
        self.current_page = 0
        self.items_per_page = 10
        self.total_pages = (len(files_list) - 1) // self.items_per_page + 1
        self.lang = lang
        self.update_buttons()

    def update_buttons(self):
        self.prev_button.disabled = self.current_page == 0
        self.next_button.disabled = self.current_page >= self.total_pages - 1

    def get_embed(self):
        start = self.current_page * self.items_per_page
        end = start + self.items_per_page
        current_items = self.files_list[start:end]

        description_lines = []
        for idx, item in enumerate(current_items, start=start + 1):
            short_name = f"snd{idx}"
            sound_shortcuts_cache[short_name] = item['filename']
            description_lines.append(f"🆔 `{short_name}` ⸺ **{item['filename']}** ({item['size']})")

        if self.lang == "en":
            embed = discord.Embed(
                title=f"Sound search results for: {self.query} (Page {self.current_page + 1}/{self.total_pages})",
                description="\n".join(description_lines) if description_lines else "No audio file data found",
                color=THEME_COLOR
            )
            embed.set_author(name="SkyWord Sound Finder", icon_url=GIF_HEADER)
            embed.set_footer(text="Use >uploadreturn command followed by ID to retrieve the audio file")
        else:
            embed = discord.Embed(
                title=f"ผลการค้นหาไฟล์เสียงของ: {self.query} (หน้า {self.current_page + 1}/{self.total_pages})",
                description="\n".join(description_lines) if description_lines else "ไม่พบไฟล์เสียงข้อมูล",
                color=THEME_COLOR
            )
            embed.set_author(name="SkyWord Sound Finder", icon_url=GIF_HEADER)
            embed.set_footer(text="ใช้คำสั่ง >uploadreturn ตามด้วยรหัส ID เพื่อดึงไฟล์เสียงกลับมา")
        return embed

    async def interaction_check(self, interaction: discord.Interaction) -> bool:
        if interaction.user.id != self.author.id:
            msg = "Is your father looking for your mother's pussy?" if self.lang == "en" else "เขาของเขาหาหีเเม่มึงหรอ"
            await interaction.response.send_message(msg, ephemeral=True)
            return False
        return True

    @discord.ui.button(label="◀ Prev Page", style=discord.ButtonStyle.grey)
    async def prev_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        self.current_page -= 1
        self.update_buttons()
        await interaction.response.edit_message(embed=self.get_embed(), view=self)

    @discord.ui.button(label="Next Page ▶", style=discord.ButtonStyle.blurple)
