def generate_safe_stereo_graph(temp_in_path):
    try:
        sound = AudioSegment.from_file(temp_in_path)
        samples = np.array(sound.get_array_of_samples(), dtype=np.float32)
        
        fig, axes = plt.subplots(3, 1, figsize=(10, 7.5), facecolor='#000000')
        fig.patch.set_facecolor('#000000')
        fig.patch.set_edgecolor('#ffffff')
        fig.patch.set_linewidth(3)
        
        step = max(1, len(samples) // 3000) 
        
        if sound.channels == 2:
            left = samples[0::2][::step]
            right = samples[1::2][::step]
        else:
            left = samples[::step]
            right = samples[::step]
            
        colors_fill = ['#ffffff', '#aaaaaa']
        colors_line = ['#e0e0e0', '#cccccc']
        colors_dark = ['#777777', '#555555']
        
        for idx, (ax, data) in enumerate(zip([axes[0], axes[1]], [left, right])):
            ax.set_facecolor('#000000')
            x = np.arange(len(data))
            
            ax.fill_between(x, data, -data, color=colors_fill[idx], alpha=0.6)
            ax.plot(x, data, color=colors_line[idx], linewidth=0.6)
            ax.plot(x, -data, color=colors_dark[idx], linewidth=0.4)
            
            ax.axis('off')
            
        ax_risk = axes[2]
        ax_risk.set_facecolor('#000000')
        
        mixed_data = (np.abs(left[:min(len(left), len(right))]) + np.abs(right[:min(len(left), len(right))])) / 2.0
        if len(mixed_data) == 0:
            mixed_data = np.abs(left)
            
        x_risk = np.arange(len(mixed_data))
        max_val = np.max(mixed_data) if np.max(mixed_data) > 0 else 1.0
        norm_risk = (mixed_data / max_val) * 100.0
        
        ax_risk.plot(x_risk, norm_risk, color='#cccccc', linewidth=0.8, alpha=0.5, label='Risk Index')
        
        risk_indices = np.where(norm_risk > 75.0)[0]
        if len(risk_indices) > 0:
            step_risk = max(1, len(risk_indices) // 150)
            ax_risk.scatter(x_risk[risk_indices[::step_risk]], norm_risk[risk_indices[::step_risk]], color='#ffffff', s=12, zorder=5, label='Danger Peak')
            
        ax_risk.spines['bottom'].set_color('#ffffff')
        ax_risk.spines['left'].set_color('#ffffff')
        ax_risk.spines['top'].set_visible(False)
        ax_risk.spines['right'].set_visible(False)
        ax_risk.tick_params(axis='x', colors='#ffffff', labelsize=8)
        ax_risk.tick_params(axis='y', colors='#ffffff', labelsize=8)
        ax_risk.set_ylabel('Risk (%)', color='#ffffff', fontsize=9)
        ax_risk.set_ylim(0, 110)
        ax_risk.grid(True, color='#222222', linestyle='--', linewidth=0.5)
        
        plt.tight_layout(pad=1.0)
        img_buf = io.BytesIO()
        plt.savefig(img_buf, format='png', facecolor='#000000', edgecolor='#ffffff', dpi=100, bbox_inches='tight') 
        img_buf.seek(0)
        plt.close()
        return img_buf
            
    except:
        fig, axes = plt.subplots(3, 1, figsize=(10, 7.5), facecolor='#000000')
        fig.patch.set_facecolor('#000000')
        fig.patch.set_edgecolor('#ffffff')
        fig.patch.set_linewidth(3)
        points = 100
        mock_data = np.sin(np.linspace(0, 10, points)) * 1000
        
        colors_fallback = ['#ffffff', '#aaaaaa']
        for idx, ax in enumerate([axes[0], axes[1]]):
            ax.set_facecolor('#000000')
            x = np.arange(points)
            ax.fill_between(x, mock_data, -mock_data, color=colors_fallback[idx], alpha=0.5)
            ax.axis('off')
            
        axes[2].set_facecolor('#000000')
        axes[2].axis('off')
            
        plt.tight_layout(pad=1.0)
        img_buf = io.BytesIO()
        plt.savefig(img_buf, format='png', facecolor='#000000', edgecolor='#ffffff', dpi=100, bbox_inches='tight')
        img_buf.seek(0)
        plt.close()
        return img_buf


