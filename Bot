        return await ctx.send(msg)

    desc_load = "Scanning stereo dual-channel frequency allocations and waveform matrices..." if lang == "en" else "ระบบกำลังตรวจสอบโครงสร้างความถี่เสียงสเตอริโอสองช่องสัญญาณ..."
    title_load = "Downloading track file..." if lang == "en" else "กำลังดาวน์โหลด..."
